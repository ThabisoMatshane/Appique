        {
          "@@type": "LocalBusiness",
          "name": "Appique",
          "url": "https://appique.co.za",
          "telephone": "+27-65-845-9839",
          "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Johannesburg",
            "addressRegion": "Gauteng",
            "addressCountry": "ZA"
          },
          "priceRange": "$$",
          "openingHours": "Mo-Fr 08:00-17:00",
          "description": "Custom software development company in Johannesburg offering web platforms, Power BI dashboards, business automation, AI solutions and cloud hosting."
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {"@@type":"Question","name":"Do you build custom software in South Africa?","acceptedAnswer":{"@@type":"Answer","text":"Yes. Appique is a South African software development company based in Johannesburg. We build fully custom web platforms, internal business systems, dashboards and automation tools for companies across South Africa."}},
            {"@@type":"Question","name":"What technologies do you use?","acceptedAnswer":{"@@type":"Answer","text":"We work with ASP.NET Core, SQL Server, Power BI, Azure cloud, React, and AI/ML integrations depending on the project needs."}},
            {"@@type":"Question","name":"How quickly can you start a project?","acceptedAnswer":{"@@type":"Answer","text":"We typically respond within one working day and can begin scoping your project within a week of initial contact."}}
          ]
        }
      ]
    }
