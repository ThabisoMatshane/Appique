                <rect x="1.5" y="1.5" width="35" height="35" rx="7.5" stroke="#0d2357" stroke-width="3" fill="none" />
                <text x="18.5" y="24" font-family="monospace" font-size="13.5" font-weight="700" fill="#0d2357" text-anchor="middle">&lt;/&gt;</text>
                <text x="46" y="26.5" font-family="'DM Sans','Segoe UI',system-ui,sans-serif" font-size="22" font-weight="700" fill="#0d2357" letter-spacing="-0.3">Appique</text>
            </svg>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
            <a href="#services" class="nav-link">Services</a>
            <a href="#why-appique" class="nav-link">Why Us</a>
