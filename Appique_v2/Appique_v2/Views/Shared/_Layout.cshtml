        <a href="#services">Services</a>
        <a href="#why-appique">Why Appique</a>
        <a href="#process">Process</a>
        <a href="#faq">FAQ</a>
        <a href="#contact" style="color:var(--gold);font-weight:700;">Get a Free Quote →</a>
