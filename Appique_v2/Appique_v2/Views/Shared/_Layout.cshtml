            <svg width="130" height="34" viewBox="0 0 148 38" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1.5" y="1.5" width="35" height="35" rx="7.5" stroke="#0d2357" stroke-width="3" fill="none" />
