            "addressRegion": "Gauteng",
            "addressCountry": "ZA"
          },
          "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+27-65-845-9839",
            "contactType": "customer service",
            "availableLanguage": "English",
            "areaServed": "ZA"
          },
          "sameAs": ["https://wa.me/27658459839"]
        },
        {
          "@@type": "WebSite",
          "@@id": "https://appique.co.za/#website",
          "url": "https://appique.co.za",
          "name": "Appique",
          "publisher": {"@@id": "https://appique.co.za/#org"}
